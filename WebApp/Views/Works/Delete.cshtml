@model WebApp.Models.Work

@{
    ViewData["Title"] = "Eliminar obra";

    var (statusText, badgeClass) = Model.Status switch
    {
        WebApp.Models.WorkStatus.InProgress => ("En progreso", "badge-status-inprogress"),
        WebApp.Models.WorkStatus.Paused => ("Pausado", "badge-status-paused"),
        WebApp.Models.WorkStatus.Finished => ("Finalizado", "badge-status-finished"),
        WebApp.Models.WorkStatus.Cancelled => ("Cancelado", "badge-status-cancelled"),
        _ => (Model.Status.ToString(), "badge-status-inprogress")
    };
}

<div class="page-header">
    <h1>Eliminar obra</h1>
</div>

<div class="danger-card">
    <span class="danger-icon">⚠️</span>
    <h3>¿Estás seguro de que quieres eliminar esta obra?</h3>
    <p>Esta acción no se puede deshacer.</p>
</div>

<div class="detail-card">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Nombre</span>
            <span class="detail-value">@Model.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Cliente</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Client) ? "—" : Model.Client)</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Fecha de inicio</span>
            <span class="detail-value">@Model.StartDate.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Fecha de fin</span>
            <span class="detail-value">@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "—")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Monto del contrato</span>
            <span class="detail-value">@Model.ContractAmount.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Monto cobrado</span>
            <span class="detail-value">@Model.CollectedAmount.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Estado</span>
            <span class="detail-value"><span class="badge @badgeClass">@statusText</span></span>
        </div>
    </div>
</div>

<form asp-action="Delete" class="form-actions mt-0 border-0 pt-0">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>