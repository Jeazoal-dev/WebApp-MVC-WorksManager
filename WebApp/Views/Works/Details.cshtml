@model WebApp.Models.Work

@{
    ViewData["Title"] = "Detalles de obra";

    var totalAgreed = Model.WorkWorkers.Sum(ww => ww.AgreedAmount);
    var totalPaid = Model.WorkWorkers.Sum(ww => ww.Payments.Where(p => !p.Cancelled).Sum(p => p.Amount));
    var totalPending = totalAgreed - totalPaid;

    var (statusText, badgeClass) = Model.Status switch
    {
        WebApp.Models.WorkStatus.InProgress => ("En progreso", "badge-status-inprogress"),
        WebApp.Models.WorkStatus.Paused => ("Pausado", "badge-status-paused"),
        WebApp.Models.WorkStatus.Finished => ("Finalizado", "badge-status-finished"),
        WebApp.Models.WorkStatus.Cancelled => ("Cancelado", "badge-status-cancelled"),
        _ => (Model.Status.ToString(), "badge-status-inprogress")
    };
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Client</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar obra</a>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>

<div class="detail-card">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Cliente</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Client) ? "—" : Model.Client)</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Estado</span>
            <span class="detail-value"><span class="badge @badgeClass">@statusText</span></span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Fecha de inicio</span>
            <span class="detail-value">@Model.StartDate.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Fecha de fin</span>
            <span class="detail-value">@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "—")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Monto del contrato</span>
            <span class="detail-value">@Model.ContractAmount.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Monto cobrado</span>
            <span class="detail-value">@Model.CollectedAmount.ToString("N2")</span>
        </div>
        <div class="detail-item detail-full">
            <span class="detail-label">Notas</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</span>
        </div>
    </div>
</div>

<div class="page-header">
    <h3 class="mb-0">Trabajadores asignados</h3>
    <a asp-controller="WorkWorkers" asp-action="Create" asp-route-workId="@Model.Id" class="btn btn-primary">
        + Asignar trabajador
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Trabajador</th>
                <th>Banco / Cuenta</th>
                <th class="text-end">Acordado</th>
                <th class="text-end">Pagado</th>
                <th class="text-end">Pendiente</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.WorkWorkers.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay trabajadores asignados a esta obra.</td>
                </tr>
            }
            else
            {
                @foreach (var ww in Model.WorkWorkers)
                {
                    var paid = ww.Payments.Where(p => !p.Cancelled).Sum(p => p.Amount);
                    var pending = ww.AgreedAmount - paid;

                    string payStatus;
                    string payBadge;

                    if (paid == 0)
                    {
                        payStatus = "Pendiente";
                        payBadge = "badge-payment-pending";
                    }
                    else if (pending <= 0)
                    {
                        payStatus = "Pagado";
                        payBadge = "badge-payment-paid";
                    }
                    else
                    {
                        payStatus = "Parcial";
                        payBadge = "badge-payment-partial";
                    }

                    <tr>
                        <td><strong>@ww.Worker?.Name</strong></td>
                        <td>
                            @ww.Worker?.Bank
                            @if (!string.IsNullOrEmpty(ww.Worker?.AccountNumber))
                            {
                                <text> / @ww.Worker.AccountNumber</text>
                            }
                        </td>
                        <td class="text-end">@ww.AgreedAmount.ToString("N2")</td>
                        <td class="text-end">@paid.ToString("N2")</td>
                        <td class="text-end">@pending.ToString("N2")</td>
                        <td><span class="badge @payBadge">@payStatus</span></td>
                        <td class="text-end">
                            <div class="action-buttons">
                                @if (pending > 0)
                                {
                                    <a asp-controller="Payments" asp-action="Create" asp-route-workWorkerId="@ww.Id"
                                       class="btn btn-sm btn-success">Registrar pago</a>
                                }
                                <a asp-controller="WorkWorkers" asp-action="Edit" asp-route-id="@ww.Id"
                                   class="btn btn-sm btn-info">Editar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
        @if (Model.WorkWorkers.Any())
        {
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="2">Totales</td>
                    <td class="text-end">@totalAgreed.ToString("N2")</td>
                    <td class="text-end">@totalPaid.ToString("N2")</td>
                    <td class="text-end">@totalPending.ToString("N2")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>