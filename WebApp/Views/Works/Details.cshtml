@model WebApp.Models.Work

@{
    ViewData["Title"] = "Work details";
}

<h1>@Model.Name</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Client:</strong> @Model.Client</p>
                <p><strong>Start date:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</p>
                <p><strong>End date:</strong> @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "-")</p>
                <p><strong>Status:</strong> @Model.Status</p>
            </div>
            <div class="col-md-6">
                <p><strong>Contract amount:</strong> @Model.ContractAmount.ToString("N2")</p>
                <p><strong>Collected amount:</strong> @Model.CollectedAmount.ToString("N2")</p>
                <p><strong>Notes:</strong> @Model.Notes</p>
            </div>
        </div>
    </div>
</div>

<h3>Assigned workers</h3>

<p>
    <a asp-controller="WorkWorkers" asp-action="Create" class="btn btn-primary">Assign worker</a>
</p>

@{
    var totalAgreed = Model.WorkWorkers.Sum(ww => ww.AgreedAmount);
    var totalPaid = Model.WorkWorkers.Sum(ww => ww.Payments.Where(p => !p.Cancelled).Sum(p => p.Amount));
    var totalPending = totalAgreed - totalPaid;
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Worker</th>
            <th>Bank / Account</th>
            <th>Agreed</th>
            <th>Paid</th>
            <th>Pending</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ww in Model.WorkWorkers)
        {
            var paid = ww.Payments.Where(p => !p.Cancelled).Sum(p => p.Amount);
            var pending = ww.AgreedAmount - paid;
            var status = paid == 0 ? "Pending" : (pending <= 0 ? "Paid" : "Partial");
            var badgeClass = status == "Paid" ? "bg-success" : (status == "Partial" ? "bg-warning text-dark" : "bg-secondary");

            <tr>
                <td>@ww.Worker?.Name</td>
                <td>
                    @ww.Worker?.Bank
                    @if (!string.IsNullOrEmpty(ww.Worker?.AccountNumber))
                    {
                        <text> / @ww.Worker.AccountNumber</text>
                    }
                </td>
                <td>@ww.AgreedAmount.ToString("N2")</td>
                <td>@paid.ToString("N2")</td>
                <td>@pending.ToString("N2")</td>
                <td><span class="badge @badgeClass">@status</span></td>
                <td>
                    @if (pending > 0)
                    {
                        <a asp-controller="Payments" asp-action="Create" asp-route-workWorkerId="@ww.Id" class="btn btn-sm btn-success">Register payment</a>
                    }
                    <a asp-controller="WorkWorkers" asp-action="Edit" asp-route-id="@ww.Id" class="btn btn-sm btn-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="fw-bold">
            <td colspan="2">Totals</td>
            <td>@totalAgreed.ToString("N2")</td>
            <td>@totalPaid.ToString("N2")</td>
            <td>@totalPending.ToString("N2")</td>
            <td colspan="2"></td>
        </tr>
    </tfoot>
</table>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit work</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>