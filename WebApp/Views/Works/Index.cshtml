@model WebApp.Models.WorkFilterViewModel

@{
    ViewData["Title"] = "Obras";

    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Name)
        || !string.IsNullOrWhiteSpace(Model.Client)
        || Model.Status.HasValue
        || Model.StartDateFrom.HasValue
        || Model.StartDateTo.HasValue
        || Model.EndDateFrom.HasValue
        || Model.EndDateTo.HasValue
        || Model.ContractAmountMin.HasValue
        || Model.ContractAmountMax.HasValue;
}

<div class="page-header">
    <h1>Obras</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary filter-toggle"
                data-bs-toggle="collapse" data-bs-target="#filterPanel"
                aria-expanded="@(hasActiveFilters ? "true" : "false")"
                aria-controls="filterPanel">
            Filtros <span class="chevron">▼</span>
        </button>
        <a asp-action="Create" class="btn btn-primary">+ Nueva obra</a>
    </div>
</div>

<div class="collapse @(hasActiveFilters ? "show" : "")" id="filterPanel">
    <form asp-action="Index" method="get" class="filter-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Client" class="form-label"></label>
                <input asp-for="Client" class="form-control" placeholder="Buscar por cliente..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<WebApp.Models.WorkStatus>()">
                    <option value="">-- Todos --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="StartDateFrom" class="form-label"></label>
                <input asp-for="StartDateFrom" type="date" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="StartDateTo" class="form-label"></label>
                <input asp-for="StartDateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDateFrom" class="form-label"></label>
                <input asp-for="EndDateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDateTo" class="form-label"></label>
                <input asp-for="EndDateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="ContractAmountMin" class="form-label"></label>
                <input asp-for="ContractAmountMin" class="form-control" placeholder="Mínimo" />
            </div>
            <div class="col-md-3">
                <label asp-for="ContractAmountMax" class="form-label"></label>
                <input asp-for="ContractAmountMax" class="form-control" placeholder="Máximo" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Total: <strong>@Model.TotalCount</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle table-works">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cliente</th>
                <th>Fecha inicio</th>
                <th>Fecha fin</th>
                <th class="text-end">Monto contrato</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    var (statusText, badgeClass) = item.Status switch
                    {
                        WebApp.Models.WorkStatus.InProgress => ("En progreso", "badge-status-inprogress"),
                        WebApp.Models.WorkStatus.Paused => ("Pausado", "badge-status-paused"),
                        WebApp.Models.WorkStatus.Finished => ("Finalizado", "badge-status-finished"),
                        WebApp.Models.WorkStatus.Cancelled => ("Cancelado", "badge-status-cancelled"),
                        _ => (item.Status.ToString(), "badge-status-inprogress")
                    };

                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Client</td>
                        <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@(item.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="text-end">@item.ContractAmount.ToString("N2")</td>
                        <td><span class="badge @badgeClass">@statusText</span></td>
                        <td class="text-end">
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new
{
    CurrentPage = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize
})