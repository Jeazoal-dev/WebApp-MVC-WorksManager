@model WebApp.Models.WorkFilterViewModel

@{
    ViewData["Title"] = "Works";
}

<h1>Works</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New work</a>
</p>

<form asp-action="Index" method="get" class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Client" class="form-label"></label>
                <input asp-for="Client" class="form-control" placeholder="Buscar por cliente..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-control"
                        asp-items="Html.GetEnumSelectList<WebApp.Models.WorkStatus>()">
                    <option value="">-- Todos --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="StartDateFrom" class="form-label"></label>
                <input asp-for="StartDateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="StartDateTo" class="form-label"></label>
                <input asp-for="StartDateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDateFrom" class="form-label"></label>
                <input asp-for="EndDateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDateTo" class="form-label"></label>
                <input asp-for="EndDateTo" type="date" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="ContractAmountMin" class="form-label"></label>
                <input asp-for="ContractAmountMin" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="ContractAmountMax" class="form-label"></label>
                <input asp-for="ContractAmountMax" class="form-control" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

<p>Resultados: <strong>@Model.Results.Count</strong></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Cliente</th>
            <th>Fecha inicio</th>
            <th>Fecha fin</th>
            <th>Monto contrato</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Results.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No se encontraron resultados.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Results)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Client</td>
                    <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@(item.EndDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>@item.ContractAmount.ToString("N2")</td>
                    <td>@Html.DisplayFor(_ => item.Status)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>