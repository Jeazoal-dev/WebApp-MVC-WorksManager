@{
    ViewData["Title"] = "Dashboard";

    // Valores del ViewBag (ajusta los nombres si en tu controller son distintos)
    int activeWorks    = ViewBag.ActiveWorks   ?? 0;
    int totalWorks     = ViewBag.TotalWorks    ?? 0;
    int activeWorkers  = ViewBag.ActiveWorkers ?? 0;
    decimal totalPaid  = ViewBag.TotalPaid     ?? 0m;
    decimal totalPend  = ViewBag.TotalPending  ?? 0m;

    // Porcentajes para las barras de progreso
    var worksPercent   = totalWorks > 0 ? (activeWorks * 100 / totalWorks) : 0;
    var workersPercent = totalWorks > 0 ? Math.Min((activeWorkers * 100 / Math.Max(totalWorks, 1)), 100) : 0;
    var paidTotal      = totalPaid + totalPend;
    var paidPercent    = paidTotal > 0 ? (int)(totalPaid * 100 / paidTotal) : 0;
    var pendingPercent = 100 - paidPercent;
}

<div class="dashboard-header">
    <div>
        <h1>Dashboard</h1>
        <p class="dashboard-subtitle">Resumen general · @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
    </div>
</div>

@* ---------- KPIs ---------- *@
<div class="kpi-grid">

    <a class="kpi-card kpi-blue" asp-controller="Works" asp-action="Index">
        <div class="kpi-header">
            <p class="kpi-label">Obras activas</p>
            <div class="kpi-icon">🏗️</div>
        </div>
        <div class="kpi-value">@activeWorks</div>
        <p class="kpi-subtitle">de @totalWorks en total</p>
        <div class="kpi-progress">
            <div class="kpi-progress-fill" style="width: @worksPercent%"></div>
        </div>
    </a>

    <a class="kpi-card kpi-cyan" asp-controller="Workers" asp-action="Index">
        <div class="kpi-header">
            <p class="kpi-label">Trabajadores activos</p>
            <div class="kpi-icon">👷</div>
        </div>
        <div class="kpi-value">@activeWorkers</div>
        <p class="kpi-subtitle">disponibles</p>
        <div class="kpi-progress">
            <div class="kpi-progress-fill" style="width: @workersPercent%"></div>
        </div>
    </a>

    <a class="kpi-card kpi-green" asp-controller="Payments" asp-action="Index">
        <div class="kpi-header">
            <p class="kpi-label">Total pagado</p>
            <div class="kpi-icon">💵</div>
        </div>
        <div class="kpi-value">@totalPaid.ToString("N2")</div>
        <p class="kpi-subtitle">a trabajadores</p>
        <div class="kpi-progress">
            <div class="kpi-progress-fill" style="width: @paidPercent%"></div>
        </div>
    </a>

    <a class="kpi-card kpi-red" asp-controller="WorkWorkers" asp-action="Index">
        <div class="kpi-header">
            <p class="kpi-label">Total pendiente</p>
            <div class="kpi-icon">⏳</div>
        </div>
        <div class="kpi-value">@totalPend.ToString("N2")</div>
        <p class="kpi-subtitle">por pagar</p>
        <div class="kpi-progress">
            <div class="kpi-progress-fill" style="width: @pendingPercent%"></div>
        </div>
    </a>

</div>

@* ---------- Paneles inferiores ---------- *@
<div class="row g-4">

    @* Panel: Obras activas *@
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-header">
                <h2>Obras activas</h2>
                <a class="panel-link" asp-controller="Works" asp-action="Index">Ver todas →</a>
            </div>
            <div class="panel-body">
                @if (ViewBag.ActiveWorksList != null && ((IEnumerable<dynamic>)ViewBag.ActiveWorksList).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Obra</th>
                                    <th class="text-end">Acordado</th>
                                    <th class="text-end">Pagado</th>
                                    <th class="text-end">Pendiente</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in ViewBag.ActiveWorksList)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Works" asp-action="Details" asp-route-id="@w.Id">
                                                @w.Name
                                            </a>
                                        </td>
                                        <td class="text-end">@(((decimal)w.Agreed).ToString("N2"))</td>
                                        <td class="text-end">@(((decimal)w.Paid).ToString("N2"))</td>
                                        <td class="text-end fw-semibold">@(((decimal)w.Pending).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="panel-empty">
                        <span class="panel-empty-icon">📭</span>
                        No hay obras activas por ahora.
                    </div>
                }
            </div>
        </div>
    </div>

    @* Panel: Pagos recientes *@
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-header">
                <h2>Pagos recientes</h2>
                <a class="panel-link" asp-controller="Payments" asp-action="Index">Ver todos →</a>
            </div>
            <div class="panel-body">
                @if (ViewBag.RecentPayments != null && ((IEnumerable<dynamic>)ViewBag.RecentPayments).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Trabajador</th>
                                    <th>Obra</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in ViewBag.RecentPayments)
                                {
                                    <tr>
                                        <td>@(((DateTime)p.Date).ToString("dd/MM/yyyy"))</td>
                                        <td>@p.Worker</td>
                                        <td>@p.Work</td>
                                        <td class="text-end fw-semibold">@(((decimal)p.Amount).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="panel-empty">
                        <span class="panel-empty-icon">💸</span>
                        No hay pagos registrados recientemente.
                    </div>
                }
            </div>
        </div>
    </div>

</div>