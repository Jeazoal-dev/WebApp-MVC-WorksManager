@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var warning = TempData["Warning"] as string;
    var info = TempData["Info"] as string;
}

@if (!string.IsNullOrEmpty(success) || !string.IsNullOrEmpty(error)
     || !string.IsNullOrEmpty(warning) || !string.IsNullOrEmpty(info))
{
    <div class="toast-container-custom" id="toastContainer">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="toast-custom toast-success" data-toast>
                <div class="toast-icon">✓</div>
                <div class="toast-body-custom">@success</div>
                <button type="button" class="toast-close" aria-label="Cerrar">×</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="toast-custom toast-error" data-toast>
                <div class="toast-icon">!</div>
                <div class="toast-body-custom">@error</div>
                <button type="button" class="toast-close" aria-label="Cerrar">×</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(warning))
        {
            <div class="toast-custom toast-warning" data-toast>
                <div class="toast-icon">!</div>
                <div class="toast-body-custom">@warning</div>
                <button type="button" class="toast-close" aria-label="Cerrar">×</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(info))
        {
            <div class="toast-custom toast-info" data-toast>
                <div class="toast-icon">i</div>
                <div class="toast-body-custom">@info</div>
                <button type="button" class="toast-close" aria-label="Cerrar">×</button>
            </div>
        }
    </div>
}