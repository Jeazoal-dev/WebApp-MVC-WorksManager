@model WebApp.Models.Worker

@{
    ViewData["Title"] = "Eliminar trabajador";

    var isActive = string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase);
    var statusText = isActive ? "Activo" : "Inactivo";
    var badgeClass = isActive ? "badge-worker-active" : "badge-worker-inactive";
}

<div class="page-header">
    <h1>Eliminar trabajador</h1>
</div>

<div class="danger-card">
    <span class="danger-icon">⚠️</span>
    <h3>¿Estás seguro de que quieres eliminar este trabajador?</h3>
    <p>Esta acción no se puede deshacer. Si el trabajador tiene pagos o asignaciones, podría fallar el borrado.</p>
</div>

<div class="detail-card">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Nombre</span>
            <span class="detail-value">@Model.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Estado</span>
            <span class="detail-value"><span class="badge @badgeClass">@statusText</span></span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Documento</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Document) ? "—" : Model.Document)</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Teléfono</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Banco</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Bank) ? "—" : Model.Bank)</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Número de cuenta</span>
            <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.AccountNumber) ? "—" : Model.AccountNumber)</span>
        </div>
    </div>
</div>

<form asp-action="Delete" class="form-actions mt-0 border-0 pt-0">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>