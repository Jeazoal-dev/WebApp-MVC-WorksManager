@model WebApp.Models.WorkerFilterViewModel

@{
    ViewData["Title"] = "Trabajadores";

    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Name)
        || !string.IsNullOrWhiteSpace(Model.Document)
        || !string.IsNullOrWhiteSpace(Model.Phone)
        || !string.IsNullOrWhiteSpace(Model.Bank)
        || !string.IsNullOrWhiteSpace(Model.Status);
}

<div class="page-header">
    <h1>Trabajadores</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary filter-toggle"
                data-bs-toggle="collapse" data-bs-target="#filterPanel"
                aria-expanded="@(hasActiveFilters ? "true" : "false")"
                aria-controls="filterPanel">
            Filtros <span class="chevron">▼</span>
        </button>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo trabajador</a>
    </div>
</div>

<div class="collapse @(hasActiveFilters ? "show" : "")" id="filterPanel">
    <form asp-action="Index" method="get" class="filter-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Document" class="form-label"></label>
                <input asp-for="Document" class="form-control" placeholder="Buscar por documento..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" placeholder="Buscar por teléfono..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Bank" class="form-label"></label>
                <input asp-for="Bank" class="form-control" placeholder="Buscar por banco..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="Active">Activo</option>
                    <option value="Inactive">Inactivo</option>
                </select>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Total: <strong>@Model.TotalCount</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle table-works">
        <thead>
            <tr>
                <th class="sortable @(Model.SortBy == "name" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="name"
                       asp-route-SortDir="@(Model.SortBy == "name" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-Name="@Model.Name" asp-route-Document="@Model.Document"
                       asp-route-Phone="@Model.Phone" asp-route-Bank="@Model.Bank" asp-route-Status="@Model.Status">
                        Nombre <span class="sort-icon">@(Model.SortBy == "name" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "document" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="document"
                       asp-route-SortDir="@(Model.SortBy == "document" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-Name="@Model.Name" asp-route-Document="@Model.Document"
                       asp-route-Phone="@Model.Phone" asp-route-Bank="@Model.Bank" asp-route-Status="@Model.Status">
                        Documento <span class="sort-icon">@(Model.SortBy == "document" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "phone" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="phone"
                       asp-route-SortDir="@(Model.SortBy == "phone" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-Name="@Model.Name" asp-route-Document="@Model.Document"
                       asp-route-Phone="@Model.Phone" asp-route-Bank="@Model.Bank" asp-route-Status="@Model.Status">
                        Teléfono <span class="sort-icon">@(Model.SortBy == "phone" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "bank" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="bank"
                       asp-route-SortDir="@(Model.SortBy == "bank" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-Name="@Model.Name" asp-route-Document="@Model.Document"
                       asp-route-Phone="@Model.Phone" asp-route-Bank="@Model.Bank" asp-route-Status="@Model.Status">
                        Banco <span class="sort-icon">@(Model.SortBy == "bank" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th>Cuenta</th>
                <th class="sortable @(Model.SortBy == "status" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="status"
                       asp-route-SortDir="@(Model.SortBy == "status" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-Name="@Model.Name" asp-route-Document="@Model.Document"
                       asp-route-Phone="@Model.Phone" asp-route-Bank="@Model.Bank" asp-route-Status="@Model.Status">
                        Estado <span class="sort-icon">@(Model.SortBy == "status" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    var isActive = string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase);
                    var statusText = isActive ? "Activo" : "Inactivo";
                    var badgeClass = isActive ? "badge-worker-active" : "badge-worker-inactive";

                    <tr>
                        <td data-label="Nombre"><strong>@item.Name</strong></td>
                        <td data-label="Documento">@item.Document</td>
                        <td data-label="Teléfono">@item.Phone</td>
                        <td data-label="Banco">@item.Bank</td>
                        <td data-label="Cuenta">@item.AccountNumber</td>
                        <td data-label="Estado"><span class="badge @badgeClass">@statusText</span></td>
                        <td data-label="Acciones">
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new
{
    CurrentPage = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize
})