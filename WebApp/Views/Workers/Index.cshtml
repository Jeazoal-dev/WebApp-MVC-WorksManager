@model WebApp.Models.WorkerFilterViewModel

@{
    ViewData["Title"] = "Trabajadores";
}

<div class="page-header">
    <h1>Trabajadores</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo trabajador</a>
</div>

<form asp-action="Index" method="get" class="filter-panel">
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Buscar por nombre..." />
        </div>
        <div class="col-md-3">
            <label asp-for="Document" class="form-label"></label>
            <input asp-for="Document" class="form-control" placeholder="Buscar por documento..." />
        </div>
        <div class="col-md-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" placeholder="Buscar por teléfono..." />
        </div>
        <div class="col-md-3">
            <label asp-for="Bank" class="form-label"></label>
            <input asp-for="Bank" class="form-control" placeholder="Buscar por banco..." />
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="">-- Todos --</option>
                <option value="Active">Activo</option>
                <option value="Inactive">Inactivo</option>
            </select>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Resultados: <strong>@Model.Results.Count</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Teléfono</th>
                <th>Banco</th>
                <th>Cuenta</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    var isActive = string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase);
                    var statusText = isActive ? "Activo" : "Inactivo";
                    var badgeClass = isActive ? "badge-worker-active" : "badge-worker-inactive";

                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Document</td>
                        <td>@item.Phone</td>
                        <td>@item.Bank</td>
                        <td>@item.AccountNumber</td>
                        <td><span class="badge @badgeClass">@statusText</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>