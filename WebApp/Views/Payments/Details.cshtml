@model WebApp.Models.Payment

@{
    ViewData["Title"] = "Payment details";
}

<h1>Payment details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Work</dt>
        <dd class="col-sm-10">@Model.WorkWorker?.Work?.Name</dd>

        <dt class="col-sm-2">Worker</dt>
        <dd class="col-sm-10">@Model.WorkWorker?.Worker?.Name</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Amount)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Amount)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Date)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Date)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PaymentMethod)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PaymentMethod)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Bank)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Bank)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Reference)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Reference)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Cancelled)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Cancelled)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Notes)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to list</a>
</div>