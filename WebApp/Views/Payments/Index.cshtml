@model WebApp.Models.PaymentFilterViewModel

@{
    ViewData["Title"] = "Pagos";

    var hasActiveFilters = Model.WorkId.HasValue
        || Model.WorkerId.HasValue
        || !string.IsNullOrWhiteSpace(Model.PaymentMethod)
        || !string.IsNullOrWhiteSpace(Model.Bank)
        || !string.IsNullOrWhiteSpace(Model.Reference)
        || Model.DateFrom.HasValue
        || Model.DateTo.HasValue
        || Model.AmountMin.HasValue
        || Model.AmountMax.HasValue
        || Model.Cancelled.HasValue;
}

<div class="page-header">
    <h1>Pagos</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary filter-toggle"
                data-bs-toggle="collapse" data-bs-target="#filterPanel"
                aria-expanded="@(hasActiveFilters ? "true" : "false")"
                aria-controls="filterPanel">
            Filtros <span class="chevron">▼</span>
        </button>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo pago</a>
    </div>
</div>

<div class="collapse @(hasActiveFilters ? "show" : "")" id="filterPanel">
    <form asp-action="Index" method="get" class="filter-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="WorkId" class="form-label"></label>
                <select asp-for="WorkId" class="form-select">
                    <option value="">-- Todas --</option>
                    @foreach (var w in Model.Works)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="WorkerId" class="form-label"></label>
                <select asp-for="WorkerId" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var w in Model.Workers)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <input asp-for="PaymentMethod" class="form-control" placeholder="Buscar por método..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Bank" class="form-label"></label>
                <input asp-for="Bank" class="form-control" placeholder="Buscar por banco..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" placeholder="Buscar por referencia..." />
            </div>
            <div class="col-md-3">
                <label asp-for="DateFrom" class="form-label"></label>
                <input asp-for="DateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="DateTo" class="form-label"></label>
                <input asp-for="DateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="AmountMin" class="form-label"></label>
                <input asp-for="AmountMin" class="form-control" placeholder="Monto mínimo" />
            </div>
            <div class="col-md-3">
                <label asp-for="AmountMax" class="form-label"></label>
                <input asp-for="AmountMax" class="form-control" placeholder="Monto máximo" />
            </div>
            <div class="col-md-3">
                <label asp-for="Cancelled" class="form-label"></label>
                <select asp-for="Cancelled" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="false">Activos</option>
                    <option value="true">Cancelados</option>
                </select>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Total: <strong>@Model.TotalCount</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle table-payments">
        <thead>
            <tr>
                <th class="sortable @(Model.SortBy == "date" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="date"
                       asp-route-SortDir="@(Model.SortBy == "date" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-PaymentMethod="@Model.PaymentMethod" asp-route-Bank="@Model.Bank"
                       asp-route-Reference="@Model.Reference" asp-route-DateFrom="@Model.DateFrom"
                       asp-route-DateTo="@Model.DateTo" asp-route-AmountMin="@Model.AmountMin"
                       asp-route-AmountMax="@Model.AmountMax" asp-route-Cancelled="@Model.Cancelled">
                        Fecha <span class="sort-icon">@(Model.SortBy == "date" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th>Obra</th>
                <th>Trabajador</th>
                <th class="sortable text-end @(Model.SortBy == "amount" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="amount"
                       asp-route-SortDir="@(Model.SortBy == "amount" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-PaymentMethod="@Model.PaymentMethod" asp-route-Bank="@Model.Bank"
                       asp-route-Reference="@Model.Reference" asp-route-DateFrom="@Model.DateFrom"
                       asp-route-DateTo="@Model.DateTo" asp-route-AmountMin="@Model.AmountMin"
                       asp-route-AmountMax="@Model.AmountMax" asp-route-Cancelled="@Model.Cancelled">
                        Monto <span class="sort-icon">@(Model.SortBy == "amount" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "method" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="method"
                       asp-route-SortDir="@(Model.SortBy == "method" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-PaymentMethod="@Model.PaymentMethod" asp-route-Bank="@Model.Bank"
                       asp-route-Reference="@Model.Reference" asp-route-DateFrom="@Model.DateFrom"
                       asp-route-DateTo="@Model.DateTo" asp-route-AmountMin="@Model.AmountMin"
                       asp-route-AmountMax="@Model.AmountMax" asp-route-Cancelled="@Model.Cancelled">
                        Método <span class="sort-icon">@(Model.SortBy == "method" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "bank" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="bank"
                       asp-route-SortDir="@(Model.SortBy == "bank" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-PaymentMethod="@Model.PaymentMethod" asp-route-Bank="@Model.Bank"
                       asp-route-Reference="@Model.Reference" asp-route-DateFrom="@Model.DateFrom"
                       asp-route-DateTo="@Model.DateTo" asp-route-AmountMin="@Model.AmountMin"
                       asp-route-AmountMax="@Model.AmountMax" asp-route-Cancelled="@Model.Cancelled">
                        Banco <span class="sort-icon">@(Model.SortBy == "bank" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "status" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="status"
                       asp-route-SortDir="@(Model.SortBy == "status" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-PaymentMethod="@Model.PaymentMethod" asp-route-Bank="@Model.Bank"
                       asp-route-Reference="@Model.Reference" asp-route-DateFrom="@Model.DateFrom"
                       asp-route-DateTo="@Model.DateTo" asp-route-AmountMin="@Model.AmountMin"
                       asp-route-AmountMax="@Model.AmountMax" asp-route-Cancelled="@Model.Cancelled">
                        Estado <span class="sort-icon">@(Model.SortBy == "status" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    <tr>
                        <td data-label="Fecha">@item.Date.ToString("dd/MM/yyyy")</td>
                        <td data-label="Obra">@item.WorkWorker?.Work?.Name</td>
                        <td data-label="Trabajador">@item.WorkWorker?.Worker?.Name</td>
                        <td data-label="Monto">@item.Amount.ToString("N2")</td>
                        <td data-label="Método">@item.PaymentMethod</td>
                        <td data-label="Banco">@item.Bank</td>
                        <td data-label="Estado">
                            @if (item.Cancelled)
                            {
                                <span class="badge badge-payment-cancelled">Cancelado</span>
                            }
                            else
                            {
                                <span class="badge badge-payment-active">Activo</span>
                            }
                        </td>
                        <td data-label="Acciones">
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new
{
    CurrentPage = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize
})