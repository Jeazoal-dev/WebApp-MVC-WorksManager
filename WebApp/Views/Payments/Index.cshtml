@model WebApp.Models.PaymentFilterViewModel

@{
    ViewData["Title"] = "Pagos";

    var hasActiveFilters = Model.WorkId.HasValue
        || Model.WorkerId.HasValue
        || !string.IsNullOrWhiteSpace(Model.PaymentMethod)
        || !string.IsNullOrWhiteSpace(Model.Bank)
        || !string.IsNullOrWhiteSpace(Model.Reference)
        || Model.DateFrom.HasValue
        || Model.DateTo.HasValue
        || Model.AmountMin.HasValue
        || Model.AmountMax.HasValue
        || Model.Cancelled.HasValue;
}

<div class="page-header">
    <h1>Pagos</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary filter-toggle"
                data-bs-toggle="collapse" data-bs-target="#filterPanel"
                aria-expanded="@(hasActiveFilters ? "true" : "false")"
                aria-controls="filterPanel">
            Filtros <span class="chevron">▼</span>
        </button>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo pago</a>
    </div>
</div>

<div class="collapse @(hasActiveFilters ? "show" : "")" id="filterPanel">
    <form asp-action="Index" method="get" class="filter-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="WorkId" class="form-label"></label>
                <select asp-for="WorkId" class="form-select">
                    <option value="">-- Todas --</option>
                    @foreach (var w in Model.Works)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="WorkerId" class="form-label"></label>
                <select asp-for="WorkerId" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var w in Model.Workers)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <input asp-for="PaymentMethod" class="form-control" placeholder="Buscar por método..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Bank" class="form-label"></label>
                <input asp-for="Bank" class="form-control" placeholder="Buscar por banco..." />
            </div>
            <div class="col-md-3">
                <label asp-for="Reference" class="form-label"></label>
                <input asp-for="Reference" class="form-control" placeholder="Buscar por referencia..." />
            </div>
            <div class="col-md-3">
                <label asp-for="DateFrom" class="form-label"></label>
                <input asp-for="DateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="DateTo" class="form-label"></label>
                <input asp-for="DateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="AmountMin" class="form-label"></label>
                <input asp-for="AmountMin" class="form-control" placeholder="Monto mínimo" />
            </div>
            <div class="col-md-3">
                <label asp-for="AmountMax" class="form-label"></label>
                <input asp-for="AmountMax" class="form-control" placeholder="Monto máximo" />
            </div>
            <div class="col-md-3">
                <label asp-for="Cancelled" class="form-label"></label>
                <select asp-for="Cancelled" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="false">Activos</option>
                    <option value="true">Cancelados</option>
                </select>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Resultados: <strong>@Model.Results.Count</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Obra</th>
                <th>Trabajador</th>
                <th class="text-end">Monto</th>
                <th>Método</th>
                <th>Banco</th>
                <th>Referencia</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    <tr>
                        <td>@item.Date.ToString("dd/MM/yyyy")</td>
                        <td>@item.WorkWorker?.Work?.Name</td>
                        <td>@item.WorkWorker?.Worker?.Name</td>
                        <td class="text-end">@item.Amount.ToString("N2")</td>
                        <td>@item.PaymentMethod</td>
                        <td>@item.Bank</td>
                        <td>@item.Reference</td>
                        <td>
                            @if (item.Cancelled)
                            {
                                <span class="badge badge-payment-cancelled">Cancelado</span>
                            }
                            else
                            {
                                <span class="badge badge-payment-active">Activo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>