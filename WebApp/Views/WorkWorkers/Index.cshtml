@model WebApp.Models.WorkWorkerFilterViewModel

@{
    ViewData["Title"] = "Asignaciones";

    var hasActiveFilters = Model.WorkId.HasValue
        || Model.WorkerId.HasValue
        || Model.AgreedAmountMin.HasValue
        || Model.AgreedAmountMax.HasValue;
}

<div class="page-header">
    <h1>Asignaciones</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary filter-toggle"
                data-bs-toggle="collapse" data-bs-target="#filterPanel"
                aria-expanded="@(hasActiveFilters ? "true" : "false")"
                aria-controls="filterPanel">
            Filtros <span class="chevron">▼</span>
        </button>
        <a asp-action="Create" class="btn btn-primary">+ Nueva asignación</a>
    </div>
</div>

<div class="collapse @(hasActiveFilters ? "show" : "")" id="filterPanel">
    <form asp-action="Index" method="get" class="filter-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="WorkId" class="form-label"></label>
                <select asp-for="WorkId" class="form-select">
                    <option value="">-- Todas --</option>
                    @foreach (var w in Model.Works)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="WorkerId" class="form-label"></label>
                <select asp-for="WorkerId" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var w in Model.Workers)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="AgreedAmountMin" class="form-label"></label>
                <input asp-for="AgreedAmountMin" class="form-control" placeholder="Monto mínimo" />
            </div>
            <div class="col-md-3">
                <label asp-for="AgreedAmountMax" class="form-label"></label>
                <input asp-for="AgreedAmountMax" class="form-control" placeholder="Monto máximo" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Total: <strong>@Model.TotalCount</strong></span>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle table-works">
        <thead>
            <tr>
                <th class="sortable @(Model.SortBy == "work" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="work"
                       asp-route-SortDir="@(Model.SortBy == "work" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-AgreedAmountMin="@Model.AgreedAmountMin" asp-route-AgreedAmountMax="@Model.AgreedAmountMax">
                        Obra <span class="sort-icon">@(Model.SortBy == "work" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable @(Model.SortBy == "worker" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="worker"
                       asp-route-SortDir="@(Model.SortBy == "worker" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-AgreedAmountMin="@Model.AgreedAmountMin" asp-route-AgreedAmountMax="@Model.AgreedAmountMax">
                        Trabajador <span class="sort-icon">@(Model.SortBy == "worker" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="sortable text-end @(Model.SortBy == "agreedamount" ? "active" : "")">
                    <a asp-action="Index" asp-route-SortBy="agreedamount"
                       asp-route-SortDir="@(Model.SortBy == "agreedamount" && Model.SortDir == "asc" ? "desc" : "asc")"
                       asp-route-WorkId="@Model.WorkId" asp-route-WorkerId="@Model.WorkerId"
                       asp-route-AgreedAmountMin="@Model.AgreedAmountMin" asp-route-AgreedAmountMax="@Model.AgreedAmountMax">
                        Acordado <span class="sort-icon">@(Model.SortBy == "agreedamount" ? (Model.SortDir == "asc" ? "▲" : "▼") : "▼")</span>
                    </a>
                </th>
                <th class="text-end">Pagado</th>
                <th class="text-end">Pendiente</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Results.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results)
                {
                    var paid = item.Payments?.Where(p => !p.Cancelled).Sum(p => p.Amount) ?? 0;
                    var pending = item.AgreedAmount - paid;

                    string statusText;
                    string badgeClass;

                    if (paid == 0)
                    {
                        statusText = "Pendiente";
                        badgeClass = "badge-payment-pending";
                    }
                    else if (pending <= 0)
                    {
                        statusText = "Pagado";
                        badgeClass = "badge-payment-paid";
                    }
                    else
                    {
                        statusText = "Parcial";
                        badgeClass = "badge-payment-partial";
                    }

                    <tr>
                        <td data-label="Obra"><strong>@item.Work?.Name</strong></td>
                        <td data-label="Trabajador">@item.Worker?.Name</td>
                        <td data-label="Acordado">@item.AgreedAmount.ToString("N2")</td>
                        <td data-label="Pagado">@paid.ToString("N2")</td>
                        <td data-label="Pendiente">@pending.ToString("N2")</td>
                        <td data-label="Estado"><span class="badge @badgeClass">@statusText</span></td>
                        <td data-label="Acciones">
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new
{
    CurrentPage = Model.Page,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize
})