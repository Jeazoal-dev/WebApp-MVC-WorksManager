@model WebApp.Models.WorkWorker

@{
    ViewData["Title"] = "Eliminar asignación";

    var paid = Model.Payments?.Where(p => !p.Cancelled).Sum(p => p.Amount) ?? 0;
    var pending = Model.AgreedAmount - paid;
}

<div class="page-header">
    <h1>Eliminar asignación</h1>
</div>

<div class="danger-card">
    <span class="danger-icon">⚠️</span>
    <h3>¿Estás seguro de que quieres eliminar esta asignación?</h3>
    <p>Esta acción no se puede deshacer. Si tiene pagos registrados, también deberías revisarlos.</p>
</div>

<div class="detail-card">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Obra</span>
            <span class="detail-value">@Model.Work?.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Trabajador</span>
            <span class="detail-value">@Model.Worker?.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Monto acordado</span>
            <span class="detail-value">@Model.AgreedAmount.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Pagado / Pendiente</span>
            <span class="detail-value">@paid.ToString("N2") / @pending.ToString("N2")</span>
        </div>
    </div>
</div>

<form asp-action="Delete" class="form-actions mt-0 border-0 pt-0">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>